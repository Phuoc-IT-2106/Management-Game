<Project Sdk="Godot.NET.Sdk/4.7.2"><PropertyGroup><TargetFramework>net10.0</TargetFramework><EnableDynamicLoading>true</EnableDynamicLoading></PropertyGroup>
<ItemGroup><ProjectReference Include="../../src/ManagementGame.Infrastructure/ManagementGame.Infrastructure.csproj" /></ItemGroup>
<!-- The Godot SDK references GodotSharpEditor in Debug only, but one packages.lock.json serves every configuration. Other
     configurations (Release, ExportDebug, ExportRelease) reference it without assets, so locked restores agree and no
     editor API is compiled in or shipped. -->
<ItemGroup Condition="'$(Configuration)' != 'Debug'"><PackageReference Include="GodotSharpEditor" Version="$(PackageVersion_GodotSharp)" ExcludeAssets="all" PrivateAssets="all" /></ItemGroup></Project>
